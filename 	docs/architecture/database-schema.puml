@startuml Roots of Impact - Database Schema
skinparam backgroundColor #FFFFFF
skinparam linetype ortho

entity users {
  * id : UUID <<PK>>
  --
  * email : VARCHAR <<UNIQUE>>
  * password_hash : VARCHAR
  * name : VARCHAR
  * role : VARCHAR
  points : INTEGER
  avatar_url : TEXT
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity tasks {
  * id : UUID <<PK>>
  --
  * title : VARCHAR
  description : TEXT
  * type : VARCHAR
  * points : INTEGER
  video_url : TEXT
  quiz_questions : JSONB
  qr_code : VARCHAR
  photo_required : BOOLEAN
  co2_savings_kg : DECIMAL
  external_id : VARCHAR
  * active : BOOLEAN
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity user_tasks {
  * id : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  * task_id : UUID <<FK>>
  completed_at : TIMESTAMP
  photo_url : TEXT
  quiz_answers : JSONB
  points_earned : INTEGER
}

entity rewards {
  * id : UUID <<PK>>
  --
  * title : VARCHAR
  description : TEXT
  * points_cost : INTEGER
  * reward_type : VARCHAR
  voucher_code : VARCHAR
  external_api_id : VARCHAR
  * active : BOOLEAN
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity reward_redemptions {
  * id : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  * reward_id : UUID <<FK>>
  redeemed_at : TIMESTAMP
  voucher_code : VARCHAR
  * status : VARCHAR
}

entity forest_trees {
  * id : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  tree_type : VARCHAR
  * position_x : DECIMAL
  * position_y : DECIMAL
  * position_z : DECIMAL
  planted_at : TIMESTAMP
  task_id : UUID <<FK>>
}

entity user_consent {
  * user_id : UUID <<PK>> <<FK>>
  --
  * consent_data : JSONB
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity statistics {
  * id : UUID <<PK>>
  --
  * metric_name : VARCHAR <<UNIQUE>>
  * metric_value : DECIMAL
  last_updated : TIMESTAMP
}

users ||--o{ user_tasks : completes
tasks ||--o{ user_tasks : tracked_in
users ||--o{ reward_redemptions : redeems
rewards ||--o{ reward_redemptions : redeemed_as
users ||--o{ forest_trees : plants
tasks ||--o| forest_trees : triggers
users ||--|| user_consent : has

@enduml
