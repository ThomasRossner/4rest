@startuml Roots of Impact - System Overview
skinparam backgroundColor #FFFFFF
skinparam componentStyle rectangle

package "Frontend Layer" {
  component [React PWA] as Frontend
  component [Three.js 3D] as ThreeJS
  component [Service Worker] as ServiceWorker
  Frontend --> ThreeJS
  Frontend --> ServiceWorker
}

package "Backend API Layer" {
  component [Express API] as Backend
  component [Authentication] as Auth
  component [Task Service] as TaskService
  component [Gamification] as Gamification
  component [Statistics] as Statistics
  component [Reward Service] as RewardService
  
  Backend --> Auth
  Backend --> TaskService
  Backend --> Gamification
  Backend --> Statistics
  Backend --> RewardService
}

package "Integration Layer" {
  component [HotelKit API] as HotelKit
  component [Voucher System] as Voucher
  component [Video Hosting] as VideoHost
}

package "Data Layer" {
  database "PostgreSQL" as PostgreSQL
  database "Redis Cache" as Redis
}

package "External Services" {
  cloud "HotelKit Platform" as HotelKitExt
  cloud "Voucher Providers" as VoucherExt
  cloud "Video CDN" as VideoExt
}

Frontend --> Backend : REST API\nWebSocket
Backend --> PostgreSQL : Database Queries
Backend --> Redis : Caching
Backend --> HotelKit : Sync Tasks
Backend --> Voucher : Generate/Validate
Backend --> VideoHost : Serve Videos

HotelKit --> HotelKitExt : API Integration
Voucher --> VoucherExt : External APIs
VideoHost --> VideoExt : Content Delivery

@enduml
