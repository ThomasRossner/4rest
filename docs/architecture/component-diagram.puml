@startuml Roots of Impact - Component Diagram
skinparam backgroundColor #FFFFFF
skinparam componentStyle rectangle

package "Frontend - React Application" {
  [Page Components] as Pages
  [Task Components] as TaskComponents
  [Forest 3D] as Forest3D
  [API Client] as APIClient
  [State Management] as State
  
  Pages --> TaskComponents
  Pages --> Forest3D
  TaskComponents --> APIClient
  Forest3D --> APIClient
  Pages --> State
}

package "Backend - Express API" {
  [Route Handlers] as Routes
  [Controllers] as Controllers
  [Services] as Services
  [Middleware] as Middleware
  
  Routes --> Middleware
  Routes --> Controllers
  Controllers --> Services
}

package "Services Layer" {
  [User Service] as UserService
  [Task Service] as TaskService
  [Gamification Service] as GamificationService
  [Reward Service] as RewardService
  [Statistics Service] as StatisticsService
  [Forest Service] as ForestService
}

package "Integration Adapters" {
  [HotelKit Adapter] as HotelKitAdapter
  [Voucher Adapter] as VoucherAdapter
}

package "Data Layer" {
  [Database Pool] as DBPool
  [Redis Client] as RedisClient
}

package "External Systems" {
  [HotelKit API] as HotelKitExt
  [Voucher APIs] as VoucherExt
}

APIClient --> Routes : HTTP/REST\nWebSocket
Middleware --> Controllers : Auth/Validation

Services --> UserService
Services --> TaskService
Services --> GamificationService
Services --> RewardService
Services --> StatisticsService
Services --> ForestService

TaskService --> HotelKitAdapter
RewardService --> VoucherAdapter

UserService --> DBPool
TaskService --> DBPool
GamificationService --> DBPool
RewardService --> DBPool
StatisticsService --> DBPool
ForestService --> DBPool

StatisticsService --> RedisClient : Cache

HotelKitAdapter --> HotelKitExt : Sync
VoucherAdapter --> VoucherExt : Generate/Validate

@enduml
