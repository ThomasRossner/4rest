@startuml Roots of Impact - Deployment Diagram
allowmixing
skinparam backgroundColor #FFFFFF

cloud "CDN" {
  node "Static Assets" as CDN
  node "Video Content" as VideoCDN
}

node "Load Balancer" as LB

node "Frontend Cluster" {
  component [React PWA] as Frontend1
  component [React PWA] as Frontend2
}

node "Backend Cluster" {
  component [Express API] as Backend1
  component [Express API] as Backend2
  database "Redis Cache" as RedisCluster
}

database "PostgreSQL Primary" as PostgresPrimary {
  component [Write Operations]
}

database "PostgreSQL Replica" as PostgresReplica {
  component [Read Operations]
}

cloud "External Services" {
  node "HotelKit API" as HotelKit
  node "Voucher APIs" as VoucherAPIs
  node "Email Service" as EmailService
}

cloud "Monitoring" {
  node "Logging ELK CloudWatch" as Logging
  node "Metrics Prometheus" as Metrics
}

User --> CDN : Static Files
User --> LB : HTTPS
LB --> Frontend1 : Load Balanced
LB --> Frontend2 : Load Balanced

Frontend1 --> Backend1 : API Calls
Frontend2 --> Backend2 : API Calls

Backend1 --> PostgresPrimary : Writes
Backend2 --> PostgresPrimary : Writes
Backend1 --> PostgresReplica : Reads
Backend2 --> PostgresReplica : Reads

Backend1 --> RedisCluster : Cache
Backend2 --> RedisCluster : Cache

Backend1 --> HotelKit : Integration
Backend2 --> HotelKit : Integration
Backend1 --> VoucherAPIs : Integration
Backend2 --> VoucherAPIs : Integration
Backend1 --> EmailService : Notifications

Backend1 --> Logging : Logs
Backend2 --> Logging : Logs
Backend1 --> Metrics : Metrics
Backend2 --> Metrics : Metrics

CDN --> VideoCDN : Video Streaming
Frontend1 --> VideoCDN : Video Requests
Frontend2 --> VideoCDN : Video Requests

@enduml
