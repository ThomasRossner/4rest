# Remote Deployment Configuration
# Copy this file to deploy-homeserver-remote.env and adjust values
# Then source it before running the deployment script:
#   source scripts/deploy-homeserver-remote.env
#   ./scripts/deploy-homeserver-remote.sh

# Homeserver connection
export HOMESERVER_HOST="homeserver"
export HOMESERVER_USER="neueradmin"
export HOMESERVER_PASSWORD="REMOVED_PASSWORD"

# Deployment path on homeserver
export DEPLOYMENT_PATH="/home/neueradmin/roots-of-impact"

# Git repository URL (only needed for first-time setup)
export REPO_URL=""

