# Multi-stage build for production frontend
FROM node:18-alpine AS builder

WORKDIR /app

# Copy package files (including package-lock.json if it exists)
COPY frontend/package*.json ./
COPY frontend/package-lock.json* ./

# Install dependencies without workspaces to ensure all deps are in local node_modules
# Use npm install if package-lock.json doesn't exist, otherwise use npm ci
RUN if [ -f package-lock.json ]; then npm ci --no-workspaces; else npm install --no-workspaces; fi

# Copy source code
COPY frontend/ .

# Build application
RUN npm run build

# Production stage with Nginx
FROM nginx:alpine

# Copy built files from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom nginx configuration
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

# Healthcheck - Nginx läuft auf Port 3000 (intern im Container)
# Caddy leitet von außen auf Port 3001 weiter
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:3000/ || exit 1

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]

