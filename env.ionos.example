# 4rest - IONOS Production Environment Variables
# Copy this file to .env and fill in your production values
# Server: ionos (87.106.86.203)

# ============================================
# Database Configuration
# ============================================
POSTGRES_USER=roots_user
POSTGRES_PASSWORD=roots_password
POSTGRES_DB=roots_of_impact

# ============================================
# Backend Configuration
# ============================================
NODE_ENV=production
PORT=5000
JWT_SECRET=jwt_secret
JWT_EXPIRES_IN=7d
SESSION_SECRET=jwt_secret
CORS_ORIGIN=http://87.106.86.203:3001
BASE_URL=http://87.106.86.203:5000

# ============================================
# Frontend Configuration
# ============================================
VITE_API_URL=http://87.106.86.203:5000/api

# ============================================
# External API Integrations
# ============================================
# HotelKit Integration
HOTELKIT_API_URL=
HOTELKIT_API_KEY=

# SIHOT Integration
SIHOT_USE_MOCK=false
SIHOT_API_URL=
SIHOT_API_KEY=
SIHOT_TIMEOUT_MS=15000
SIHOT_SYNC_INTERVAL_MS=900000
HOTEL_ID=ROI-BER

# Voucher Integration
VOUCHER_API_URL=
VOUCHER_API_KEY=

# ============================================
# Email Configuration
# ============================================
EMAIL_ENABLED=true
EMAIL_MOCK_MODE=false
EMAIL_FROM=4rest@luise.eco
EMAIL_FROM_NAME=4rest
APP_URL=http://87.106.86.203:3001
FRONTEND_URL=http://87.106.86.203:3001

# SMTP Configuration
SMTP_HOST=rossner.synology.me
SMTP_PORT=25
SMTP_SECURE=true
SMTP_USER=thomas
SMTP_PASS=Tan0808zen
SMTP_FROM=4rest@luise.eco

# ============================================
# OAuth Configuration (Optional)
# ============================================
# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://87.106.86.203:5000/api/auth/github/callback

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://87.106.86.203:5000/api/auth/google/callback

# Facebook OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://87.106.86.203:5000/api/auth/facebook/callback

# Apple OAuth (Sign in with Apple)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=http://87.106.86.203:5000/api/auth/apple/callback

# ============================================
# Notes
# ============================================
# 1. Generate a strong JWT_SECRET: openssl rand -base64 32
# 2. Use the same value for SESSION_SECRET or generate another one
# 3. Update CORS_ORIGIN and FRONTEND_URL to match your domain when using Caddy
# 4. Update OAuth callback URLs to match your production domain
# 5. Set EMAIL_MOCK_MODE=false and configure SMTP for production emails

